# Leave empty to use the saved Copilot CLI login.
# For token authentication, use a fine-grained GitHub token with Copilot Requests permission.
COPILOT_GITHUB_TOKEN=

# Run npm run auth:setup to configure a shared household login in .env.
# Required for every server startup. Do not put a plaintext password here.
# HOUSEHOLD_USERNAME=
# HOUSEHOLD_PASSWORD_HASH=
# APP_ORIGIN=https://meals.example.com
# HOST=0.0.0.0
# ALLOW_NETWORK_ACCESS=true
# NODE_ENV=production

# Optional settings (uncomment to override the defaults).
# PORT=3000
# COPILOT_MODEL=auto
# COPILOT_VISION_MODEL=
# COPILOT_CLI_PATH=
# COPILOT_HOME=
# Optional Unsplash API key for recipe photo search.
# UNSPLASH_ACCESS_KEY=
