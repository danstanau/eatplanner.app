# Leave empty to use the saved Copilot CLI login.
# For token authentication, use a fine-grained GitHub token with Copilot Requests permission.
COPILOT_GITHUB_TOKEN=

# Optional settings (uncomment to override the defaults).
# PORT=3000
# COPILOT_MODEL=auto
# COPILOT_VISION_MODEL=
# COPILOT_CLI_PATH=
# COPILOT_HOME=
# Optional Unsplash API key for recipe photo search.
# UNSPLASH_ACCESS_KEY=
