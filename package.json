{
  "name": "eatplanner.app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A simple household meal planner powered by the GitHub Copilot SDK.",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "build:client": "vite build",
    "build": "npm run build:client && tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "pretest": "npm run build:client",
    "test": "tsx --test server/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.client.json",
    "auth:setup": "tsx scripts/setup-auth.ts",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@microsoft/copilot-sdk": "2.0.0",
    "express": "^5.1.0",
    "heic-convert": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "happy-dom": "^21.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
