{
  "name": "eatplanner.app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A simple household meal planner powered by the GitHub Copilot SDK.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsx --test server/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.34",
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
